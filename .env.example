# Copiază acest fișier ca .env și completează valorile.
# Fără .env, containerul pornește dar rutele SSR (/@[username]) vor fi limitate.

# Publica — inlinată în build (necesară pentru docker compose build)
PUBLIC_CLERK_PUBLISHABLE_KEY=

# Secretă — runtime, citită de server prin astro:env/server
CLERK_SECRET_KEY=

# Portul local expus de container
APP_PORT=4321
