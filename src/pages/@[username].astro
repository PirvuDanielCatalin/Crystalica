---
// src/pages/@[username].astro - Public crystal profile (SSR from Clerk Backend API)
export const prerender = false;

import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { fetchClerkUserProfile, type PublicProfile } from '../utils/clerk-server';

const username = Astro.params.username;
const profile = await fetchClerkUserProfile(username);

const crystals = await getCollection('crystals');
const sorted = [...crystals].sort((a, b) => a.data.name.localeCompare(b.data.name, 'ro'));

const crystalIndex = sorted.map((crystal) => ({
  name: crystal.data.name,
  slug: crystal.data.slug,
  image: crystal.data.image || '',
  formula: crystal.data.chemicalFormula || '',
}));

if (!profile) {
  Astro.response.headers.set('x-robots-tag', 'noindex');
}

const portfolioSlugs = profile
  ? new Set(Object.entries(profile.collections).filter(([, s]) => s === 'p').map(([k]) => k))
  : new Set<string>();
const wishlistSlugs = profile
  ? new Set(Object.entries(profile.collections).filter(([, s]) => s === 'w').map(([k]) => k))
  : new Set<string>();

const title = profile
  ? `${profile.fullName} — Profil Crystalica`
  : 'Profil negăsit — Crystalica';

const description = profile
  ? `Portofoliul și lista de dorințe a lui ${profile.fullName} pe Crystalica.`
  : 'Profilul pe care îl cauți nu există.';
---

{profile
  ? (
<BaseLayout
  title={title}
  description={description}
  noIndex
>
  <div class="portfolio-page" data-portfolio-page>
    <div class="portfolio-content" data-portfolio-content>
      <!-- Central header banner with user info -->
      <header class="portfolio-profile-header relative px-4 sm:px-6 pb-5 sm:pb-6">
        <div class="portfolio-profile-avatar">
          {profile.imageUrl ? (
            <img src={profile.imageUrl} alt={profile.fullName} data-profile-img />
          ) : (
            <div class="portfolio-avatar-placeholder" data-avatar-placeholder aria-hidden="true">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
          )}
        </div>
        <div class="portfolio-profile-info">
          <h1 class="portfolio-profile-name">{profile.fullName}</h1>
          <div class="portfolio-profile-stats">
            <span class="portfolio-stat">
              <strong data-portfolio-count>{portfolioSlugs.size}</strong> cristale în portofoliu
            </span>
            <span class="portfolio-stat-separator" aria-hidden="true">·</span>
            <span class="portfolio-stat">
              <strong data-wishlist-count>{wishlistSlugs.size}</strong> în lista de dorințe
            </span>
          </div>
        </div>
        <button type="button" class="follow-btn" data-follow-btn hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="follow-btn-check" hidden>
            <polyline points="20 6 9 17 4 12"/>
          </svg>
          <span class="follow-btn-text">Urmărește</span>
        </button>
      </header>

      <!-- Two-panel layout: sidebar left, content right -->
      <div class="portfolio-layout">
        <!-- Left sidebar -->
        <aside class="portfolio-sidebar overflow-x-auto overflow-y-hidden scrollbar-hide -mb-px overscroll-x-contain xl:overflow-visible xl:mb-0 xl:p-3 xl:sticky xl:top-20">
          <nav class="portfolio-nav">
            <button type="button" class="portfolio-nav-item portfolio-nav-active" data-nav-tab="portfolio">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 3l7 4v10l-7 4-7-4V7l7-4Z"/>
                <path d="M12 3v18"/>
              </svg>
              Portofoliul personal
            </button>
            <button type="button" class="portfolio-nav-item" data-nav-tab="following" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
              </svg>
              Profile urmărite
            </button>
            <button type="button" class="portfolio-nav-item" data-nav-tab="settings" hidden>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <circle cx="12" cy="12" r="3"/>
                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
              </svg>
              Configurație cont
            </button>
          </nav>
        </aside>

        <!-- Right content area -->
        <main class="portfolio-main p-3 sm:p-4 flex flex-col gap-4 xl:flex-row xl:gap-6 xl:justify-center bg-zinc-50 dark:bg-zinc-900">
          <!-- Portfolio tab (shows both lists together) -->
          <section class="portfolio-tab portfolio-tab-active" data-tab="portfolio">
            <div class="portfolio-tab-header">
              <h2>Portofoliul {profile.fullName}</h2>
              <span class="portfolio-tab-count" data-portfolio-count-2>{portfolioSlugs.size} cristale</span>
            </div>

            <div class="portfolio-section">
              <h3 class="portfolio-section-title">Portofoliu</h3>
              <div class="portfolio-grid" data-portfolio-grid>
                {crystalIndex
                  .filter((item) => portfolioSlugs.has(item.slug))
                  .map((item) => (
                    <article class="portfolio-item" data-state="portfolio" data-slug={item.slug}>
                      <a href={`/cristale/${item.slug}`} class="portfolio-item-link">
                        <div class="portfolio-item-img">
                          {item.image
                            ? <img src={item.image} alt="" loading="lazy" />
                            : (
                              <div class="portfolio-item-placeholder">
                                <svg width="36" height="36" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                                  <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                  <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                  <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                              </div>
                            )}
                        </div>
                        <div class="portfolio-item-body">
                          <span class="portfolio-item-name">{item.name}</span>
                        </div>
                      </a>
                      <div class="portfolio-item-actions portfolio-item-actions-owner" data-item-actions="p" hidden>
                        <button type="button" class="portfolio-action portfolio-action-move portfolio-action-move-w" data-portfolio-move={item.slug} data-next="w">Mută în lista de dorințe</button>
                        <button type="button" class="portfolio-action portfolio-action-remove" data-portfolio-remove={item.slug}>Elimină</button>
                      </div>
                    </article>
                  ))}
              </div>
              <p class="portfolio-empty" data-portfolio-empty hidden>Nu sunt cristale în portofoliu.</p>
            </div>

            <div class="portfolio-section">
              <h3 class="portfolio-section-title">Lista de dorințe</h3>
              <div class="portfolio-grid" data-wishlist-grid>
                {crystalIndex
                  .filter((item) => wishlistSlugs.has(item.slug))
                  .map((item) => (
                    <article class="portfolio-item" data-state="wishlist" data-slug={item.slug}>
                      <a href={`/cristale/${item.slug}`} class="portfolio-item-link">
                        <div class="portfolio-item-img">
                          {item.image
                            ? <img src={item.image} alt="" loading="lazy" />
                            : (
                              <div class="portfolio-item-placeholder">
                                <svg width="36" height="36" viewBox="0 0 32 32" fill="none" aria-hidden="true">
                                  <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                                  <path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                  <path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                                </svg>
                              </div>
                            )}
                        </div>
                        <div class="portfolio-item-body">
                          <span class="portfolio-item-name">{item.name}</span>
                        </div>
                      </a>
                      <div class="portfolio-item-actions portfolio-item-actions-owner" data-item-actions="w" hidden>
                        <button type="button" class="portfolio-action portfolio-action-move" data-portfolio-move={item.slug} data-next="p">Mută în portofoliu</button>
                        <button type="button" class="portfolio-action portfolio-action-remove" data-portfolio-remove={item.slug}>Elimină</button>
                      </div>
                    </article>
                  ))}
              </div>
              <p class="portfolio-empty" data-wishlist-empty hidden>Nu sunt cristale în lista de dorințe.</p>
            </div>
          </section>

          <!-- Settings tab (owner only) -->
          <section class="portfolio-tab" data-tab="settings" hidden>
            <div class="portfolio-tab-header">
              <h2>Configurație cont</h2>
            </div>
            <div class="portfolio-settings">
              <div class="portfolio-settings-section">
                <h3>Profil</h3>
                <button type="button" class="portfolio-settings-btn" data-open-profile>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                  </svg>
                  Modifică poza de profil
                </button>
                <button type="button" class="portfolio-settings-btn" data-open-password>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                  </svg>
                  Schimbă parola
                </button>
              </div>
              <div class="portfolio-settings-section">
                <h3>Cont</h3>
                <button type="button" class="portfolio-settings-btn portfolio-settings-btn-danger" data-logout-btn>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                    <polyline points="16 17 21 12 16 7"/>
                  </svg>
                  Deconectare
                </button>
              </div>
            </div>
          </section>

          <!-- Following tab (owner only) -->
          <section class="portfolio-tab" data-tab="following" hidden>
            <div class="portfolio-tab-header">
              <h2>Profile Urmărite</h2>
              <span class="portfolio-tab-count" data-following-count>0 persoane</span>
            </div>
            <div class="following-grid" data-following-grid></div>
            <p class="portfolio-empty" data-following-empty hidden>Nu urmărești încă niciun profil.</p>
          </section>
        </main>
      </div>
    </div>
  </div>

  <script is:inline type="application/json" id="crystal-index" set:html={JSON.stringify(crystalIndex)}></script>
  <script is:inline type="application/json" id="route-username" set:html={`"${username}"`}></script>
  <script is:inline type="application/json" id="server-collections" set:html={JSON.stringify(profile.collections)}></script>
  <script is:inline type="application/json" id="server-followed" set:html={JSON.stringify(profile.followed || [])}></script>
</BaseLayout>
  )
  : (
<BaseLayout
  title="Profil negăsit — Crystalica"
  description="Utilizatorul pe care îl cauți nu există."
  noIndex
>
  <div class="error-page">
    <div class="error-container">
      <div class="error-icon" aria-hidden="true">
        <svg width="64" height="64" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke-linejoin="round"/>
          <path d="M16 8V24" stroke-linecap="round"/>
          <path d="M10 16H22" stroke-linecap="round"/>
        </svg>
      </div>
      <h1 class="error-title">Profil negăsit</h1>
      <p class="error-subtitle">Utilizatorul <strong>@{username}</strong> nu există pe Crystalica.</p>
      <div class="error-actions">
        <a href="/" class="btn-primary">Înapoi la prima pagină</a>
        <a href="/cristale" class="btn-secondary">Vezi toate cristalele</a>
      </div>
    </div>
  </div>
</BaseLayout>
  )}

<script is:inline>
  (function () {
    const routeUsername = typeof window !== 'undefined'
      ? (document.getElementById('route-username')?.textContent || '').replace(/^"|"$/g, '')
      : '';

    const serverCollections = typeof window !== 'undefined'
      ? JSON.parse(document.getElementById('server-collections')?.textContent || '{}')
      : {};

    const serverFollowed = typeof window !== 'undefined'
      ? JSON.parse(document.getElementById('server-followed')?.textContent || '[]')
      : [];

    let collections = serverCollections;
    let followed = serverFollowed; // array of usernames being followed
    let isOwner = false;

    function waitForClerkReady(timeout = 15000) {
      return new Promise((resolve, reject) => {
        const start = Date.now();
        const check = () => {
          const clerk = window.__crystalicaClerk;
          if (clerk && window.__crystalicaClerkStatus === 'ready') {
            resolve(clerk);
          } else if (Date.now() - start > timeout) {
            resolve(clerk || null);
          } else {
            setTimeout(check, 100);
          }
        };
        check();
      });
    }

    function escapeHtml(value) {
      return value
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function activateOwnerMode() {
      isOwner = true;

      // Show settings nav item
      document.querySelectorAll('[data-nav-tab="settings"]').forEach(el => el.hidden = false);
      
      // Show following nav item
      const followingNav = document.querySelector('[data-nav-tab="following"]');
      if (followingNav) followingNav.hidden = false;

      // Show action buttons on all items
      document.querySelectorAll('.portfolio-item-actions-owner').forEach(el => el.hidden = false);

      // Show settings tab content (hidden by default)
      // Tab switching already works
      
      // Render followed users grid if on own profile
      if (routeUsername.toLowerCase() === window.__crystalicaClerk?.user?.username?.toLowerCase()) {
        renderFollowingGrid();
      }
    }
    
    function isFollowing(username) {
      return followed.some(u => u.toLowerCase() === username.toLowerCase());
    }
    
    function toggleFollow(btn) {
      const clerk = window.__crystalicaClerk;
      if (!clerk?.user) return;
      
      const userUsername = clerk.user.username || '';
      const targetUsername = routeUsername;
      
      if (userUsername.toLowerCase() === targetUsername.toLowerCase()) {
        // Owner viewing own profile - follow/unfollow button hidden
        return;
      }
      
      const currentlyFollowing = isFollowing(targetUsername);
      
      if (currentlyFollowing) {
        // Unfollow
        followed = followed.filter(u => u.toLowerCase() !== targetUsername.toLowerCase());
        btn.classList.remove('is-following');
        btn.dataset.following = 'false';
        
        // Update button text
        const textSpan = btn.querySelector('.follow-btn-text');
        if (textSpan) textSpan.textContent = 'Urmărește';
        
        const checkIcon = btn.querySelector('.follow-btn-check');
        if (checkIcon) checkIcon.hidden = true;
        
        // Save to user metadata
        saveFollowed(clerk.user, followed);
      } else {
        // Follow
        followed = [...followed, targetUsername];
        btn.classList.add('is-following');
        btn.dataset.following = 'true';
        
        // Update button text
        const textSpan = btn.querySelector('.follow-btn-text');
        if (textSpan) textSpan.textContent = 'Urmaresc';
        
        const checkIcon = btn.querySelector('.follow-btn-check');
        if (checkIcon) checkIcon.hidden = false;
        
        // Save to user metadata
        saveFollowed(clerk.user, followed);
      }
    }
    
    async function saveFollowed(user, newFollowed) {
      const unsafeMetadata = {
        ...(user.unsafeMetadata ?? {}),
        followed: newFollowed,
      };
      await user.update({ unsafeMetadata });
      document.dispatchEvent(
        new CustomEvent('crystalica:followed', { detail: newFollowed }),
      );
    }
    
    function renderFollowingGrid() {
      const grid = document.querySelector('[data-following-grid]');
      const empty = document.querySelector('[data-following-empty]');
      const count = document.querySelector('[data-following-count]');
      
      if (!grid) return;
      
      if (followed.length === 0) {
        grid.innerHTML = '';
        if (empty) empty.hidden = false;
        if (count) count.textContent = '0 persoane';
        return;
      }
      
      if (empty) empty.hidden = true;
      if (count) count.textContent = `${followed.length} persoane`;
      
      // Render cards for each followed user
      grid.innerHTML = followed.map(username => `
        <div class="following-card" data-followed-user="${escapeHtml(username)}">
          <a href="/@${escapeHtml(username)}" class="following-card-link">
            <div class="following-card-avatar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                <circle cx="12" cy="7" r="4"/>
              </svg>
            </div>
            <div class="following-card-info">
              <span class="following-card-name">@${escapeHtml(username)}</span>
              <span class="following-card-username">Urmărește</span>
            </div>
          </a>
          ${routeUsername.toLowerCase() === username.toLowerCase() ? '' : `
          <div class="following-card-actions">
            <button type="button" class="unfollow-btn" data-unfollow="${escapeHtml(username)}">
              Elimină din urmărite
            </button>
          </div>`}
        </div>
      `).join('');
    }

    function renderCounts() {
      const portfolio = Object.keys(collections).filter(k => collections[k] === 'p');
      const wishlist = Object.keys(collections).filter(k => collections[k] === 'w');

      const pCount = document.querySelector('[data-portfolio-count]');
      const wCount = document.querySelector('[data-wishlist-count]');
      const pCount2 = document.querySelector('[data-portfolio-count-2]');
      const wCount2 = document.querySelector('[data-wishlist-count]');

      if (pCount) pCount.textContent = String(portfolio.length);
      if (wCount) wCount.textContent = String(wishlist.length);
      if (pCount2) pCount2.textContent = `${portfolio.length} cristale`;
    }

    function updateGrids() {
      const indexEl = document.getElementById('crystal-index');
      const crystalIndex = indexEl ? JSON.parse(indexEl.textContent) : [];

      const portfolioGrid = document.querySelector('[data-portfolio-grid]');
      const wishlistGrid = document.querySelector('[data-wishlist-grid]');
      const portfolioEmpty = document.querySelector('[data-portfolio-empty]');
      const wishlistEmpty = document.querySelector('[data-wishlist-empty]');

      if (!portfolioGrid || !wishlistGrid) return;

      const portfolio = crystalIndex.filter(item => collections[item.slug] === 'p');
      const wishlist = crystalIndex.filter(item => collections[item.slug] === 'w');

      const renderCard = (item, state) => {
        const image = item.image
          ? `<img src="${escapeHtml(item.image)}" alt="" loading="lazy" />`
          : `<div class="portfolio-item-placeholder"><svg width="36" height="36" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 2L22 8v16L16 30L10 24V8L16 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/><path d="M16 8V24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M10 16H22" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg></div>`;

        const moveBtn = state === 'w'
          ? `<button type="button" class="portfolio-action portfolio-action-move" data-portfolio-move="${escapeHtml(item.slug)}" data-next="p">Mută în portofoliu</button>`
          : `<button type="button" class="portfolio-action portfolio-action-move portfolio-action-move-w" data-portfolio-move="${escapeHtml(item.slug)}" data-next="w">Mută în lista de dorințe</button>`;

        return `<article class="portfolio-item" data-state="${state === 'p' ? 'portfolio' : 'wishlist'}"><a href="/cristale/${escapeHtml(item.slug)}" class="portfolio-item-link"><div class="portfolio-item-img">${image}</div><div class="portfolio-item-body"><span class="portfolio-item-name">${escapeHtml(item.name)}</span></div></a><div class="portfolio-item-actions">${moveBtn}<button type="button" class="portfolio-action portfolio-action-remove" data-portfolio-remove="${escapeHtml(item.slug)}">Elimină</button></div></article>`;
      };

      portfolioGrid.innerHTML = portfolio.map(i => renderCard(i, 'p')).join('');
      wishlistGrid.innerHTML = wishlist.map(i => renderCard(i, 'w')).join('');

      if (portfolioEmpty) portfolioEmpty.hidden = portfolio.length > 0;
      if (wishlistEmpty) wishlistEmpty.hidden = wishlist.length > 0;
    }

    async function saveCollections(user) {
      const unsafeMetadata = {
        ...(user.unsafeMetadata ?? {}),
        collections: Object.entries(collections)
          .map(([slug, state]) => `${slug}:${state}`)
          .join(','),
      };
      await user.update({ unsafeMetadata });
      document.dispatchEvent(
        new CustomEvent('crystalica:collections', { detail: collections }),
      );
    }

    // Nav tab switching
    document.querySelectorAll('[data-nav-tab]').forEach(item => {
      item.addEventListener('click', () => {
        if (!isOwner) return;
        const tabName = item.dataset.navTab;
        if (!tabName) return;

        document.querySelectorAll('[data-nav-tab]').forEach(n => {
          n.classList.toggle('portfolio-nav-active', n.dataset.navTab === tabName);
        });
        document.querySelectorAll('[data-tab]').forEach(tab => {
          const isTarget = tab.dataset.tab === tabName;
          tab.hidden = !isTarget;
          tab.classList.toggle('portfolio-tab-active', isTarget);
        });
      });
    });

    // Move/remove buttons
    document.addEventListener('click', async (event) => {
      if (!isOwner) return;
      const clerk = window.__crystalicaClerk;
      const button = event.target.closest('[data-portfolio-move], [data-portfolio-remove]');
      if (!button || !clerk?.user) return;

      const slug = button.dataset.portfolioMove || button.dataset.portfolioRemove;
      if (!slug) return;

      const next = button.dataset.next;
      const previous = { ...collections };
      const nextCollections = { ...collections };

      if (button.dataset.portfolioRemove) {
        delete nextCollections[slug];
      } else if (next === 'p' || next === 'w') {
        nextCollections[slug] = next;
      }

      collections = nextCollections;
      updateGrids();
      renderCounts();

      try {
        await saveCollections(clerk.user);
      } catch (error) {
        collections = previous;
        updateGrids();
        renderCounts();
        console.error('[Crystalica] Nu am putut salva portofoliul.', error);
      }
    });

    // Settings buttons
    const openProfileBtn = document.querySelector('[data-open-profile]');
    const openPasswordBtn = document.querySelector('[data-open-password]');
    const logoutBtn = document.querySelector('[data-logout-btn]');

    openProfileBtn?.addEventListener('click', () => {
      window.__crystalicaClerk?.openUserProfile();
    });

    openPasswordBtn?.addEventListener('click', () => {
      window.__crystalicaClerk?.openUserProfile();
    });

    logoutBtn?.addEventListener('click', async () => {
      const clerk = window.__crystalicaClerk;
      if (!clerk) return;
      await clerk.signOut();
      window.location.reload();
    });

    // Listen for collection updates from other pages
    document.addEventListener('crystalica:collections', (event) => {
      const detail = (event as CustomEvent).detail;
      if (!detail) return;
      collections = detail;
      if (isOwner) {
        updateGrids();
        renderCounts();
      }
    });
    
    // Listen for follow updates from other pages
    document.addEventListener('crystalica:followed', (event) => {
      const detail = (event as CustomEvent).detail;
      if (!detail) return;
      followed = detail;
      if (isOwner) {
        renderFollowingGrid();
      }
    });

    // Initialize
    (async () => {
      const clerk = await waitForClerkReady();
      if (!clerk) return;

      const user = clerk.user;
      
      // Show follow button if viewing someone else's profile
      if (user && user.username?.toLowerCase() !== routeUsername.toLowerCase()) {
        const followBtn = document.querySelector('[data-follow-btn]');
        if (followBtn) {
          followBtn.hidden = false;
          if (isFollowing(routeUsername)) {
            followBtn.classList.add('is-following');
            followBtn.dataset.following = 'true';
            const textSpan = followBtn.querySelector('.follow-btn-text');
            if (textSpan) textSpan.textContent = 'Urmaresc';
            const checkIcon = followBtn.querySelector('.follow-btn-check');
            if (checkIcon) checkIcon.hidden = false;
          }
          followBtn.addEventListener('click', () => toggleFollow(followBtn));
        }
      }

      // Check if current user is the owner of this profile
      if (user && user.username?.toLowerCase() === routeUsername.toLowerCase()) {
        // Owner: sync from client-side Clerk user
        const metadata = user.unsafeMetadata || {};
        const raw = metadata.collections;
        const clientCollections = {};
        if (typeof raw === 'string') {
          for (const entry of raw.split(',')) {
            const sep = entry.lastIndexOf(':');
            if (sep <= 0) continue;
            const slug = entry.slice(0, sep);
            const state = entry.slice(sep + 1);
            if (slug && (state === 'p' || state === 'w')) clientCollections[slug] = state;
          }
        } else if (raw && typeof raw === 'object') {
          for (const [slug, val] of Object.entries(raw)) {
            if (val === 'p' || val === 'w') clientCollections[slug] = val;
          }
        }
        collections = clientCollections;
        updateGrids();
        renderCounts();
        
        // Sync followed from user metadata
        const rawFollowed = metadata.followed;
        if (Array.isArray(rawFollowed)) {
          followed = rawFollowed;
        } else if (typeof rawFollowed === 'string') {
          followed = rawFollowed.split(',').filter(Boolean);
        }
        
        activateOwnerMode();

        clerk.addListener(() => {
          if (!clerk.user) return;
          // Re-check ownership
          const u = clerk.user.username || '';
          if (u.toLowerCase() !== routeUsername.toLowerCase()) return;
          
          const md = clerk.user.unsafeMetadata || {};
          const r = md.collections;
          const cc = {};
          if (typeof r === 'string') {
            for (const e of r.split(',')) {
              const s = e.lastIndexOf(':');
              if (s <= 0) continue;
              const sl = e.slice(0, s);
              const st = e.slice(s + 1);
              if (sl && (st === 'p' || st === 'w')) cc[sl] = st;
            }
          }
          collections = cc;
          updateGrids();
          renderCounts();
          
          // Sync followed
          const rf = md.followed;
          if (Array.isArray(rf)) {
            followed = rf;
          } else if (typeof rf === 'string') {
            followed = rf.split(',').filter(Boolean);
          }
          renderFollowingGrid();
        });
      }
    })();
    
    // Unfollow button click handler
    document.addEventListener('click', async (event) => {
      const button = event.target.closest('[data-unfollow]');
      if (!button) return;
      
      const clerk = window.__crystalicaClerk;
      if (!clerk?.user) return;
      
      const username = button.dataset.unfollow;
      if (!username) return;
      
      const previous = [...followed];
      followed = followed.filter(u => u.toLowerCase() !== username.toLowerCase());
      renderFollowingGrid();
      
      try {
        await saveFollowed(clerk.user, followed);
      } catch (error) {
        followed = previous;
        renderFollowingGrid();
        console.error('[Crystalica] Nu am putut salva urmărirea.', error);
      }
    });
  })();
</script>

