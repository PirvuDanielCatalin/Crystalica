{
  "name": "crystalica",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/copy-assets-to-public.mjs",
    "build": "astro build && node scripts/prepare-pages-worker.mjs",
    "preview": "node scripts/ensure-preview-config.mjs && astro preview",
    "preview:pages": "wrangler pages dev dist/client",
    "clean": "rm -rf node_modules/ dist/ .astro/ .cache/ .vscode/ .wrangler/",
    "c_u_i_b": "npm run clean && npm update --ignore-scripts && npm install --ignore-scripts && npm run build",
    "c_u_i_b_d": "npm run c_u_i_b && npm run dev",
    "test:playwright": "npx playwright test tests/playwright/"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/image": "^0.18.0",
    "@astrojs/mdx": "^8.1.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@clerk/clerk-js": "^6.42.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.159.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
